# Server
PORT=3000
NODE_ENV=development

# Hosted deployments: point this at the persistent volume so the database
# survives restarts and redeploys (for example /var/data on Render).
# DATA_DIR=/var/data

# Demo role switcher. This signs requests in as any role without a password.
# Keep it false everywhere except a local training machine.
ALLOW_DEMO_LOGIN=true
VITE_ALLOW_DEMO_LOGIN=true

# Optional public Google Calendar embed (private calendars will not load in an iframe)
VITE_GOOGLE_CALENDAR_ID=""
VITE_GOOGLE_CALENDAR_EMBED_URL=""
